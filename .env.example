# Copy to .env.local. Leave a value blank until you have the real URL.
# Public vars are inlined at build time for the static export.

NEXT_PUBLIC_SITE_URL=https://davidsalami.com
NEXT_PUBLIC_EMAIL=hello@davidsalami.com
NEXT_PUBLIC_PROFILE_EMAIL=salamibusiness@gmail.com

# Stripe Payment Link for the $1000 advisory hour
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# PayPal.me or PayPal checkout URL
NEXT_PUBLIC_PAYPAL_URL=

# Full Calendly event URL, e.g. https://calendly.com/your-name/advisory
NEXT_PUBLIC_CALENDLY_URL=

# Formspree endpoint, e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Resend (newsletter). Leave blank to stub the API in development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEWSLETTER_NOTIFY_EMAIL=
